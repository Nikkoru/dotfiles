# Style
layer=overlay
background-color=#000000
text-color=#FFFFFF

font=monospace 12
width=260
height=120

outer-margin=1

border-size=1
border-color=#CFCFCF
border-radius=2

# Icons
icons=1
max-icon-size=34
icon-location=left

# Position
layer=top
anchor=bottom-right

# Notification
default-timeout=10000
ignore-timeout=0
max-visible=5
history=1

# Actions
actions=1

# Binding
on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss
